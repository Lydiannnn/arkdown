{
  "name": "arkdown",
  "productName": "Arkdown",
  "version": "1.0.4",
  "description": "A local live-rendering Markdown editor for Windows.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "build:screen-translation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-screen-translation.ts",
    "test:screen-translation-native": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON native/screen-translation/tests/run-tests.ts",
    "start": "electron-forge start",
    "build:sticky-note-native": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-sticky-note-native-surface.ts",
    "build:guide": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-user-guide.ts",
    "build:markitdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-markitdown-component.ts",
    "build:workspace-commit-helper": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-workspace-commit-helper.ts",
    "prepare:document-converter": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-markitdown-component.ts",
    "verify:markitdown": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-markitdown-component.ts",
    "prepare:ocr-dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/prepare-screenshot-ocr-dev.ts",
    "capture:guide": "npm run build:guide && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-user-guide-screenshots.ts",
    "package": "npm run package:full",
    "package:full": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/package-distribution.ts full",
    "package:lite": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/package-distribution.ts lite",
    "installer:full": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-windows-installer.ts --edition full",
    "installer:lite": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-windows-installer.ts --edition lite",
    "package:component": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/package-optional-components.ts",
    "test": "vitest run",
    "test:document-converter": "vitest run tests/shared/document-conversion.test.ts tests/shared/document-types.test.ts tests/scripts/package-markitdown-component.test.ts tests/main/arkdown-package-audit.test.ts tests/main/component-artifact-source.test.ts tests/main/document-conversion-component-manager.test.ts tests/main/markitdown-runner.test.ts tests/main/document-conversion-service.test.ts tests/main/pptx-markdown-normalization.test.ts tests/main/document-conversion-lifecycle.test.ts tests/main/document-conversion-ipc.test.ts tests/main/related-document-converter.test.ts tests/main/workspace-service.test.ts tests/preload/document-conversion-api.test.ts tests/renderer/DocumentConversionPreferencesSection.test.tsx tests/renderer/use-document-conversion.test.tsx tests/renderer/DocumentConversionDialog.test.tsx tests/renderer/document-conversion-workspace.test.tsx tests/renderer/document-session.test.ts tests/renderer/use-document-session.test.tsx",
    "test:parallel:sticky": "vitest run --maxWorkers=2 --fileParallelism tests/main/sticky-note-store.test.ts tests/main/sticky-note-importer.test.ts tests/main/sticky-note-store-recovery.test.ts",
    "test:guide": "vitest run tests/user-guide",
    "test:watch": "vitest",
    "test:e2e": "npm run package && playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language-data": "6.5.2",
    "@milkdown/crepe": "7.21.3",
    "@milkdown/kit": "7.21.3",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@phosphor-icons/react": "2.1.10",
    "@uiw/react-codemirror": "4.25.11",
    "dompurify": "3.4.12",
    "exceljs": "4.4.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "11.17.2",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "saxes": "6.0.0",
    "write-file-atomic": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "jsdom": "29.1.1",
    "resedit": "2.0.3",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
